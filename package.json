{
  "name": "sqs-webhook-dispatcher",
  "version": "0.1.0",
  "description": "Reliable webhook delivery on AWS Lambda + SQS: signed requests, exponential backoff with jitter, partial batch failures and a dead-letter queue.",
  "license": "MIT",
  "author": "Nícollas Frazão",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
